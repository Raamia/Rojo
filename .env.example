# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Real environment variables always win over anything here, so a container or a
# systemd unit that sets these keeps working unchanged.
#
# Keep it private:  chmod 600 .env

# --- model provider: set ONE of these (or both, and pick with ROJO_PROVIDER) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# anthropic | openai. Only needed when both keys are set; otherwise inferred.
# ROJO_PROVIDER=openai

# Override the provider's default model (claude-opus-4-8 / gpt-5.2).
# ROJO_MODEL=gpt-4.1

# --- server ---
# Loopback by default. Set a token before binding anywhere else: job submission
# executes code.
# ROJO_HTTP_ADDR=127.0.0.1:8080
# ROJO_AUTH_TOKEN=

# ROJO_DATA_DIR=./rojo-data
# ROJO_WORKER_COUNT=4
# ROJO_JOB_TIMEOUT=30m
